{
  // Combined Flow file: environment, context and tasks in one document.
  // JSONC = JSON with comments (and trailing commas tolerated by the parser).
  "kind": "flow", // optional artifact discriminator; lets one validator dispatch by kind
  "name": "build-and-publish",
  "description": "Combined Flow file: environment, context and tasks in one document.",

  // ---- Environment: where the Pipeline runs ----
  "environment": {
    "platform": "aws",
    "provider": "aws-ecs",
    "runtime": "container",
    "image": "node:22-alpine",
    "resources": { "cpu": "1", "memory": "2Gi" },
    "bootstrap": [
      // tasks run on container init, before the Flow's own tasks
      { "name": "install", "type": "execute", "with": { "command": "npm ci" } }
    ],
    "options": {
      // provider-specific, free-form
      "cluster": "ci-cluster",
      "subnets": ["subnet-0a1b2c3d"]
    }
  },

  // ---- Context: env, secrets, lifecycle hooks ----
  "context": {
    "env": {
      "NODE_ENV": "production",
      "REGISTRY": "ghcr.io/acme"
    },
    "secrets": {
      "NPM_TOKEN": { "provider": "aws-sm", "key": "ci/npm-token" },
      "GH_TOKEN": "${{ env.GH_TOKEN }}",
      "ANTHROPIC_API_KEY": { "provider": "aws-sm", "key": "ci/anthropic-key" }
    },
    "hooks": {
      "create": [
        { "name": "notify-start", "type": "fetch", "with": { "url": "https://hooks.example.com/start", "method": "POST", "body": { "flow": "build-and-publish" } } }
      ],
      "error": "./hooks/on-error.yaml" // a referenced Flow implements this hook
    }
  },

  // ---- Tasks: run in order ----
  "tasks": [
    {
      "name": "test",
      "type": "execute",
      "with": { "command": "npm test", "timeout": "5m" }
    },
    {
      "name": "build",
      "type": "run",
      "with": { "language": "bash", "script": "npm run build && tar czf dist.tgz dist" }
    },
    {
      "name": "upload",
      "type": "store",
      "if": "${{ tasks.build.success }}", // skip unless build succeeded
      "with": {
        "operation": "put",
        "bucket": "acme-artifacts",
        "key": "builds/dist.tgz",
        "endpoint": "https://s3.us-east-1.amazonaws.com"
      }
    },
    {
      "name": "summarize",
      "type": "chat-completion",
      "secrets": ["ANTHROPIC_API_KEY"], // only this secret is unmasked for this task
      "with": {
        "model": "claude-opus-4-8",
        "apiKey": "${{ secrets.ANTHROPIC_API_KEY }}",
        "messages": [
          { "role": "system", "content": "You summarize CI runs." },
          { "role": "user", "content": "Summarize the build result." }
        ]
      }
    },
    {
      "name": "verify",
      "type": "assert",
      "with": {
        "assertions": [
          { "actual": "${{ tasks.upload.status }}", "operator": "eq", "expected": 200, "message": "upload should succeed" }
        ]
      }
    },
    {
      "name": "deploy",
      "type": "flow",
      "with": {
        "use": "../deploy/flow.yaml",
        "input": { "artifact": "builds/dist.tgz" }
      }
    }
  ]
}
